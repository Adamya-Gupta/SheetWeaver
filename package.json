{
  "name": "gts",
  "version": "1.0.0",
  "private": true,
  "description": "Groww to Sheets Converter",
  "author": "Adamya Gupta",
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -n \"NEXT,ELECTRON\" -c \"yellow,blue\" --kill-others \"next dev\" \"electron .\"",
    "build": "next build",
    "build:exe": "npm run build && electron-builder --win",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "electron-serve": "^3.0.1",
    "exceljs": "^3.10.0",
    "file-saver": "^2.0.5",
    "next": "^16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.3",
    "electron": "^43.0.0",
     "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.gtsdesktopapp.app",
    "productName": "GTS Desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon":"logo.ico"
    }
  }
}

